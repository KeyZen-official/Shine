# ---------------------------------------------------------------------------
# Shine Consultant — environment template
# Copy to `.env.local` and adjust. The defaults below work for local
# development with no further setup.
# ---------------------------------------------------------------------------

# Canonical origin of this site. Used for canonical URLs, Open Graph URLs,
# the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# In production: NEXT_PUBLIC_SITE_URL=https://www.shineconsultant.co.in


# --- Enquiry and consultation email ---------------------------------------
# The two form handlers under app/api email submissions to the business.
# Nothing is stored: there is no database.
#
# With SMTP_HOST empty, a submission still succeeds and the failure is
# written to the server log. That is deliberate — a mail outage must not
# show an error to someone who filled the form in correctly — but it does
# mean the enquiry is lost, so set these before launch.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Shine Consultant <no-reply@shineconsultant.co.in>
ADMIN_NOTIFICATION_EMAIL=enquiry@shineconsultant.co.in


# --- Spam protection -------------------------------------------------------
# Cloudflare Turnstile. Both keys are needed for the challenge to run.
#
# Leave them unset locally: the honeypot and dwell-time checks still apply.
# Set them in production — Turnstile is the layer that actually stops
# automated abuse, because the per-address rate limit lives in process
# memory and resets on redeploy.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# --- Imagery ---------------------------------------------------------------
# Show the generated brand panels where a record has no image of its own.
# Credits are in docs/image-credits.md. Set to `false` for the designed
# typographic fallback instead.
NEXT_PUBLIC_USE_DEFAULT_IMAGERY=true
